<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault is restyled by Samsung as One UI, so platform widgets match the system. -->
    <style name="Theme.Budi" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
